<div
  id="<%= dom_id task %>"
  style="display: flex; gap: 10px"
  <%= local_assigns[:fade_in] ? 'data-controller=fade-in' : nil %>
  <%= local_assigns[:fade_out] ? 'data-controller=fade-out' : nil %>
>

  <div style="width: 20px">
    <%= checkbox_tag :completed, task.completed, task.completed %>
  </div>
  <div style="display: flex; flex: 1; align-items: center; justify-content: space-between; gap: 20px">
    <%= task.content %>

    <%= button_to "✕", task_path(task), method: :delete %>
  </div>
</div>
